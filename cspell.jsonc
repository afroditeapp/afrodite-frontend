{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "ignorePaths": [
    "**/*.g.dart",
    "**/*.freezed.dart",
    "**/packages/api_client/**",
    "**/*.lock",
    "**/*.svg",
    "**/*.arb",
    "**/l10n/**",
    "**/gradle/**",
    "**/gradlew",
    "**/values-*/**",
    "**/ios/**",
    "**/android/**",
    "**/web/**",
    "**/translations/*.*",
    "**/translations/app/*.*",
    "**/translations/app/src/main/res/xml",
    "**/LICENSE*",
    "**/about.toml",
    "**/Cargo.toml",
    "**/rust-toolchain.toml"
  ],
  "words": [
    "afrodite",
    "unban",
    "eudi",
    "jitsi",
    "openstreetmap",
    "nonbinaries",
    "nonbinary",
    "hentai",
    "seetaface",
    "zxing",
    "blocklist",
    "imgs",
    "bitflag",
    "bitflags",
    "icegen",
    "ffigen",
    "fswatch",
    "openapitools",
    "malloc",
    "ptext",
    "Schyler",
    "latlong",
    "rxdart",
    "xcodeproj",
    "subkey",
    "subkeys",
    "keypair",
    "Streamable",
    "Dismissable",
    "Slideable",
    "gradlew",
    "unawaited",
    "ctype",
    "prefs",
    "backgrounded",
    "LTWH",
    "blocklisted",
    "Undetect",
    "Unverify",
    "Mnumber",
    "daos",
    "rngs",
    "seipd",
    "aapt",
    "pubspec",
    "unallowed",
    "Elrte",
    "abackup",
    "appbundle",
    "rustup",
    "subosito",
    "softprops"
  ]
}
